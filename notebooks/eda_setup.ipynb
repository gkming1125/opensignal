# Helper: load dataset by file extension

def load_dataset(path: str, *, sheet_name: Optional[str] = None) -> pd.DataFrame:
    """
    Load a dataset from common formats: CSV, TSV, Excel, Parquet, JSON, Feather.
    - path: file path (absolute like /workspace/data/file.csv or relative)
    - sheet_name: for Excel files only
    """
    p = Path(path)
    if not p.exists():
        # Try resolving relative to DATA_DIR
        p = DATA_DIR / path
        if not p.exists():
            raise FileNotFoundError(f"File not found: {path}")

    suffix = p.suffix.lower()
    if suffix in {".csv"}:
        return pd.read_csv(p)
    if suffix in {".tsv", ".tab"}:
        return pd.read_csv(p, sep="\t")
    if suffix in {".xlsx", ".xls"}:
        return pd.read_excel(p, sheet_name=sheet_name)
    if suffix in {".parquet"}:
        return pd.read_parquet(p)
    if suffix in {".json"}:
        return pd.read_json(p)
    if suffix in {".feather", ".ft"}:
        return pd.read_feather(p)

    raise ValueError(f"Unsupported file type: {suffix}")

